
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset password</title>
  </head>
  <style>
    *{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: sans-serif;
    }
    .container{
      margin: 0 auto;
      display: flex;
      justify-content: center;
    }
    .fpass{
      margin-top: 250px;
    }
    h1{
      text-align: center;
      margin-bottom: 20px;
    }
    form{
      width: 400px;
      border: 1px solid black;
      padding: 25px;
      border-radius: 10px;
    }
    form input{
      width: 100%;
      padding: 5px;
      height: 50px;
      border-radius: 6px;
      border: 1px solid black;
      margin-bottom: 20px;
    }
    form button{
      margin-left: 100px;
      width: 150px;
      height: 50px;
      border-radius: 10px;
      border: 1px solid black;
      background-color: yellowgreen;
      font-size: 22px;
      transition: 0.7s;
      cursor: pointer;
    }
    form button:hover{
      background-color: rgb(83, 182, 83);
    }
  </style>
  <body>
    <div class="container">
      <div class="fpass">
        <h1>Reset password</h1>
        <h4 style="color: red"><%= error %></h4>
        <h4 style="color: greenyellow"><%= mess %></h4>
  
        <form action="/reset-password?token=<%=token%>" method="post">
          <input type="text" placeholder="Enter password" name="password" required/>
          <button type="submit">Submit</button>
        </form>
      </div>
    </div>
  </body>
</html>

